version: '3.8'

services:
  product-frontend:
    image: "{{ docker_registry | default('localhost:5000') }}/product-frontend:{{ version | default('latest') }}"
    container_name: product-frontend
    ports:
      - "{{ frontend_port | default('80') }}:80"
    restart: unless-stopped

    environment:
      - API_BASE_URL={{ api_base_url | default('http://localhost:8080') }}
      - ENVIRONMENT={{ environment | default('dev') }}

    volumes:
      - ./nginx-logs:/var/log/nginx

    networks:
      - internal

    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:80/"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 20s

    labels:
      - "service.name=product-frontend"
      - "service.environment={{ environment | default('dev') }}"
      - "service.version={{ version | default('latest') }}"

    depends_on:
      - user-api

networks:
  internal:
    external: false
