[Unit]
Description=Data Processor Service
Documentation=https://github.com/example/data-processor
After=network.target
Wants=network-online.target

[Service]
Type=simple
User={{ service_user | default('serviceuser') }}
Group={{ service_group | default('serviceuser') }}

# Working directory
WorkingDirectory=/opt/services/data-processor

# Environment variables
Environment="LOG_LEVEL={{ log_level | default('INFO') }}"
Environment="DATA_PATH={{ data_path | default('/var/data/processor') }}"
Environment="PROCESSING_INTERVAL={{ processing_interval | default('60') }}"
Environment="PYTHONUNBUFFERED=1"

# Load additional environment from file
EnvironmentFile=-/opt/services/data-processor/config.env

# Start command
ExecStart=/opt/services/data-processor/venv/bin/python /opt/services/data-processor/processor.py

# Restart configuration
Restart=on-failure
RestartSec=10s
StartLimitBurst=3
StartLimitInterval=60s

# Resource limits
MemoryLimit={{ memory_limit | default('512M') }}
CPUQuota={{ cpu_quota | default('50%') }}

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/data/processor /opt/services/data-processor/logs

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=data-processor

[Install]
WantedBy=multi-user.target
